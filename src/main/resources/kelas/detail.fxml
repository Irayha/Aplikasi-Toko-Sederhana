<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DetailController">
    <children>
        <VBox spacing="2.0" styleClass="header">
            <children>
                <Label styleClass="judul" text="Detail Produk" />
                <Label styleClass="subjudul" text="Informasi produk yang dipilih" />
            </children>
        </VBox>
        <VBox spacing="16.0" styleClass="konten" VBox.vgrow="ALWAYS">
            <children>
                <GridPane hgap="16.0" styleClass="kartu">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <children>
                        <Label styleClass="field-label" text="Kode Produk" GridPane.rowIndex="0" />
                        <Label fx:id="lblKode" styleClass="nilai" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="Nama Produk" GridPane.rowIndex="1" />
                        <Label fx:id="lblNama" styleClass="nilai" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="Kategori" GridPane.rowIndex="2" />
                        <Label fx:id="lblKategori" styleClass="badge" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="2" />

                        <Label styleClass="field-label" text="Harga" GridPane.rowIndex="3" />
                        <Label fx:id="lblHarga" styleClass="harga-besar" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </children>
                    <rowConstraints>
                        <javafx.scene.layout.RowConstraints minHeight="44.0" />
                        <javafx.scene.layout.RowConstraints minHeight="44.0" />
                        <javafx.scene.layout.RowConstraints minHeight="44.0" />
                        <javafx.scene.layout.RowConstraints minHeight="44.0" />
                    </rowConstraints>
                </GridPane>
                <Button onAction="#handleKembali" styleClass="tombol" text="Kembali" />
            </children>
        </VBox>
    </children>
</VBox>
