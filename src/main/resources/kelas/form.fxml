<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <children>
        <VBox spacing="2.0" styleClass="header">
            <children>
                <Label styleClass="judul" text="Tambah Produk" />
                <Label styleClass="subjudul" text="Lengkapi data produk baru" />
            </children>
        </VBox>
        <VBox spacing="16.0" styleClass="konten" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="14.0" styleClass="kartu">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="field-label" text="Kode Produk" />
                                <TextField fx:id="txtKode" promptText="Contoh: P001" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="field-label" text="Nama Produk" />
                                <TextField fx:id="txtNama" promptText="Contoh: Roti Coklat" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="field-label" text="Kategori" />
                                <ComboBox fx:id="cbKategori" maxWidth="Infinity" promptText="Pilih kategori" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="field-label" text="Harga (Rp)" />
                                <TextField fx:id="txtHarga" promptText="Contoh: 5000" />
                            </children>
                        </VBox>
                        <Label fx:id="lblError" styleClass="error" wrapText="true" />
                    </children>
                </VBox>
                <HBox spacing="8.0">
                    <children>
                        <Button onAction="#handleSimpan" styleClass="tombol" text="Simpan" />
                        <Button onAction="#handleBatal" styleClass="tombol-sekunder" text="Batal" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
