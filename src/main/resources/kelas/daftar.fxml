<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <children>
        <VBox spacing="2.0" styleClass="header">
            <children>
                <Label styleClass="judul" text="Daftar Produk Toko" />
                <Label styleClass="subjudul" text="Catat dan kelola produk makanan serta minuman" />
            </children>
        </VBox>
        <VBox spacing="16.0" styleClass="konten" VBox.vgrow="ALWAYS">
            <children>
                <HBox spacing="8.0">
                    <children>
                        <TextField fx:id="txtCari" onAction="#handleCari" promptText="Cari berdasarkan nama produk" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCari" styleClass="tombol" text="Cari" />
                        <Button onAction="#handleReset" styleClass="tombol-sekunder" text="Reset" />
                    </children>
                </HBox>
                <TableView fx:id="tabel" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="kolKode" prefWidth="100.0" text="Kode" />
                        <TableColumn fx:id="kolNama" prefWidth="260.0" text="Nama Produk" />
                        <TableColumn fx:id="kolKategori" prefWidth="120.0" text="Kategori" />
                        <TableColumn fx:id="kolHarga" prefWidth="140.0" text="Harga" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Label fx:id="lblPesan" styleClass="pesan" />
                <HBox spacing="8.0">
                    <children>
                        <Button onAction="#handleTambah" styleClass="tombol" text="Tambah Produk" />
                        <Button onAction="#handleDetail" styleClass="tombol-sekunder" text="Lihat Detail" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
